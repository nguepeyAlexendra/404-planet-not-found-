# Copier vers .env puis adapter. Ne JAMAIS committer .env.
POSTGRES_DB=nisar
POSTGRES_USER=nisar
POSTGRES_PASSWORD=change-me-avant-tout-deploiement

# prod masque la documentation interactive de l'API ; dev ou test la laissent visible
NV_ENV=prod
NV_CORS_ORIGINS=http://localhost:8080
NV_LOG_LEVEL=INFO

# true avec l'image postgis/postgis (docker-compose). false sur un PostgreSQL sans PostGIS.
NV_USE_POSTGIS=true

# Jeton Earthdata (gratuit) pour télécharger des granules NISAR depuis ASF.
# https://urs.earthdata.nasa.gov -> Generate Token. Laisser vide pour n'utiliser que la démonstration.
NV_EARTHDATA_TOKEN=
